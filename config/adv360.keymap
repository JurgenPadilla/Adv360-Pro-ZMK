#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick_tap_ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        enhe: enhe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(N) &kp N>;
            label = "ENHE";
        };

        question: question {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(QUESTION)>;
            label = "QUESTION";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&none          &kp N1         &kp N2    &kp N3    &kp N4     &kp N5  &kp LC(LA(ENTER))                                                                              &mo 3                    &kp N6  &kp N7    &kp N8        &kp N9    &kp N0         &none
&kp TAB        &kp Q          &kp W     &kp F     &kp P      &kp B   &kp LA(LC(G))                                                                                  &kp RC(RA(E))            &kp J   &kp L     &kp U         &kp Y     &kp SEMICOLON  &kp DEL
&kp GRAVE      &kp A          &kp R     &kp S     &kp T      &kp G   &kp LA(LC(LEFT_ARROW))      &kp END    &kp HOME              &kp PAGE_UP        &kp PAGE_DOWN  &kp RA(RC(RIGHT_ARROW))  &kp M   &kp N     &kp E         &kp I     &kp O          &kp SQT
&kp LSHFT      &kp Z          &kp X     &kp C     &kp D      &kp V                                          &kp LALT              &kp RIGHT_ALT                                              &kp K   &kp H     &kp COMMA     &kp DOT   &kp FSLH       &kp RSHFT
&kp LG(LS(S))  &kp LS(LG(V))  &kp CAPS  &kp LEFT  &kp RIGHT          &mt LEFT_CONTROL BACKSPACE  &lt 1 ESC  &kp LEFT_COMMAND      &kp RIGHT_COMMAND  &lt 1 ENTER    &mt RIGHT_SHIFT SPACE            &kp DOWN  &kp UP_ARROW  &kp RGUI  &kp RIGHT_ALT  &mo 2
            >;
        };

        layer_1 {
            display-name = "Base";
            bindings = <
&none          &kp F1           &kp F2         &kp F3     &kp F4      &kp F5            &none                                                                            &none                &kp F6             &kp F7          &kp F8                &kp F9                 &kp F10          &none
&kp TAB        &kp EXCLAMATION  &kp AT_SIGN    &kp POUND  &kp DOLLAR  &kp F11           &kp LC(KP_NUMBER_1)                                                              &kp RC(KP_NUMBER_2)  &kp F12            &kp PERCENT     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp COLON        &kp DELETE
&kp TILDE      &kp LCTRL        &kp AMPERSAND  &kp EQUAL  &kp MINUS   &question         &kp LC(KP_NUMBER_3)  &kp END     &kp HOME          &kp PAGE_UP    &kp PAGE_DOWN  &kp RC(KP_NUMBER_4)  &enhe              &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp DOUBLE_QUOTES
&kp LSHFT      &kp BACKSLASH    &kp PIPE       &kp PLUS   &kp UNDER   &kp LG(LA(LEFT))                                   &kp LEFT_ALT      &kp RIGHT_ALT                                      &kp RG(RA(RIGHT))  &kp ASTERISK    &kp LESS_THAN         &kp GREATER_THAN       &kp QUESTION     &kp RSHFT
&kp LG(LS(S))  &kp LG(LS(V))    &kp CAPS       &kp LEFT   &kp RIGHT                     &kp BACKSPACE        &kp ESCAPE  &kp LEFT_GUI      &kp RIGHT_GUI  &kp RS(ENTER)  &kp SPACE                               &kp DOWN_ARROW  &kp UP_ARROW          &kp LEFT_GUI           &kp RIGHT_ALT    &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp C_BRIGHTNESS_INC  &kp C_BRI_DEC  &kp F4  &kp F5  &kp F6  &tog 5                                      &mo 3   &kp K_MUTE  &kp K_VOLUME_DOWN  &kp K_VOLUME_UP  &kp C_PREVIOUS  &kp C_NEXT  &kp K_PLAY_PAUSE
&trans  &trans                &trans         &trans  &trans  &trans  &none                                       &none   &trans      &trans             &trans           &trans          &trans      &trans
&trans  &trans                &trans         &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans      &trans             &trans           &trans          &trans      &trans
&trans  &trans                &trans         &trans  &trans  &trans                  &trans      &trans                  &trans      &trans             &trans           &trans          &trans      &trans
&trans  &trans                &trans         &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans              &trans             &trans           &trans          &trans      &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
